# Токен от @BotFather
BOT_TOKEN=

# PostgreSQL (Neon / Railway / Supabase / свой)
# Принимаются postgres://, postgresql:// и postgresql+asyncpg://
DATABASE_URL=

# Google AI Studio -> API key
GEMINI_API_KEY=

# Необязательно: модель и параметры генерации
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_TOKENS=1000

# Глубина "размышлений" Gemini 3. По умолчанию модель думает
# на максимуме, из-за чего ответ приходит через 5-6 секунд.
# minimal — быстрее всего, low — быстро, off — не трогать параметр.
GEMINI_THINKING=low
GEMINI_TEMPERATURE=0.8

# Источники картинок по порядку: pixabay или pixabay,unsplash
# Pixabay подписи не требует. Unsplash требует — у его картинок
# под фото останется атрибуция, поэтому по умолчанию он выключен.
IMAGE_PROVIDERS=pixabay

# pixabay.com -> Documentation -> API (ключ виден после входа)
PIXABAY_API_KEY=

# Необязательно: Unsplash -> Applications -> Access Key
UNSPLASH_ACCESS_KEY=

# Кто может менять настройки через /settings.
# Числовые ID через запятую — узнать свой можно командой /myid.
# Если задано — только эти люди, администраторы групп доступ теряют.
# Пусто — настройками управляют админы каждой группы.
OWNER_IDS=

# Цветные логи (зелёный — норма, жёлтый — предупреждение,
# красный — ошибка). LOG_COLOR=0 отключает раскраску.
LOG_COLOR=1

# --- Экономика (алмазы) ---
# Ежедневный бонус — случайная сумма в этом диапазоне
BONUS_MIN=50
BONUS_MAX=150

# Редкий джекпот вместо обычного бонуса (шанс 5%)
JACKPOT_MIN=300
JACKPOT_MAX=500

# Награды за игры
REWARD_GAME_WIN=25
REWARD_GAME_HOST=15

# --- Опыт и уровни ---
XP_MESSAGE=2
XP_DAILY_CAP=120
XP_BONUS=30
XP_GAME_WIN=60
XP_GAME_HOST=40
XP_LIKE=5
XP_GIFT=15
LEVEL_STEP=100

# --- Крокодил ---
# Пауза между буквами подсказки, секунды
HINT_COOLDOWN=30

# --- Итоги недели ---
# День недели (0 — понедельник, 6 — воскресенье) и час UTC
DIGEST_WEEKDAY=6
DIGEST_HOUR=17

# Сколько последних сообщений группы давать модели как контекст
CONTEXT_MESSAGES=8

# Город по умолчанию для погоды, если в запросе он не указан.
# Погода берётся из Open-Meteo, ключ не нужен.
DEFAULT_CITY=Прага

# --- Крокодил с холстом (Mini App) ---
# Короткое имя приложения из BotFather: /newapp -> выбрать бота ->
# ввести URL https://<домен>/draw -> задать short name, например draw.
# Пусто — игра работает словесной версией.
WEBAPP_SHORT_NAME=

# Публичный адрес сервиса. На Railway подставляется сам
# из RAILWAY_PUBLIC_DOMAIN, задавать вручную не нужно.
PUBLIC_URL=

# --- Веб-панель ---
# Короткое имя второго Mini App из BotFather (/newapp),
# URL которого указывает на https://<домен>/admin
# Пусто — кнопка «Веб-панель» в /settings не показывается.
WEBAPP_ADMIN_NAME=

# --- Маруська Арена (дурак онлайн, сервис в папке arena/) ---
# Публичный адрес сервиса арены. Пусто — /game отвечает «скоро откроется».
ARENA_URL=
# Короткое имя Mini App арены в BotFather (/newapp, URL = ARENA_URL).
# Нужно для кнопки «Играть» в группах и для ссылок-приглашений в комнаты.
ARENA_APP_NAME=
