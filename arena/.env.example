# Тот же токен, что у бота Маруська: им проверяется подпись Telegram initData
BOT_TOKEN=
BOT_USERNAME=
# Короткое имя Mini App в BotFather (/newapp). Нужно для ссылок t.me/<бот>/<имя>?startapp=game_<id>
MINI_APP_SHORT_NAME=

# Та же база, что у бота, но схема arena (таблицы бота в public не трогаются)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/maruska?schema=arena
# Этап 2+: комнаты, присутствие, pub/sub между инстансами
REDIS_URL=redis://localhost:6379

# Подпись сессий: 32+ случайных символа (openssl rand -hex 32)
SESSION_SECRET=
SESSION_TTL_HOURS=24
INIT_DATA_MAX_AGE_SECONDS=3600

# Секрет для вызовов бот → арена (/internal/*), этап 6
INTERNAL_API_SECRET=

SIGNUP_BONUS_CREDITS=1450
RAKE_PERCENT=5

PORT=8080
LOG_LEVEL=info
# Только локально: вход тестовым игроком без Telegram. В production запрещено.
DEV_AUTH=0
